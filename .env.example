# Application
# Local: APP_ENV=local + APP_URL=http://localhost:3000
# Vercel: APP_ENV=production + APP_URL=https://your-domain (no trailing slash)
APP_ENV=local
APP_URL=http://localhost:3000

# Turso (required)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Macro / markets
FRED_API_KEY=
FINNHUB_API_KEY=
# LIVE_MARKET_QUOTES=true

# AI (optional)
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=llama-3.1-8b-instant

# Auth
# Vercel: use a fresh random JWT_SECRET (>=32 chars)
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_EXPIRE_DAYS=14
JWT_ISSUER=tell
AUTH_COOKIE_NAME=tell_session
AUTH_COOKIE_SAMESITE=lax
# Unset = Secure in production; off locally
# AUTH_COOKIE_SECURE=
AUTH_RATE_LIMIT_PER_MINUTE=20
# Optional OTP HMAC pepper (falls back to JWT_SECRET; required in production via JWT_SECRET)
# OTP_PEPPER=

# Rate limits (per IP / minute)
API_RATE_LIMIT_PER_MINUTE=60
WRITE_RATE_LIMIT_PER_MINUTE=30
HEALTH_RATE_LIMIT_PER_MINUTE=120
BRIEF_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=20

# Registration + email
REGISTRATION_ENABLED=true
EMAIL_OTP_ENABLED=true
EMAIL_DELIVERY_ENABLED=true
# Watchlist brief email is opt-in
WATCHLIST_BRIEF_EMAIL=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tell Research <noreply@example.com>
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# Local only — never set on Vercel
# TELL_OTP_DEV_ECHO=1
# LIVE_MARKET_QUOTES=false
