# Application
APP_ENV=local
APP_URL=http://localhost:3000

# Turso
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Macro / markets
FRED_API_KEY=
FINNHUB_API_KEY=

# AI
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth (JWT httpOnly cookie — email OTP registration, no OIDC)
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_EXPIRE_DAYS=14
JWT_ISSUER=tell
AUTH_COOKIE_NAME=tell_session
AUTH_COOKIE_SAMESITE=lax
# Leave unset → Secure on in production / SameSite=none; off for local
# AUTH_COOKIE_SECURE=
AUTH_RATE_LIMIT_PER_MINUTE=20
# Optional dedicated HMAC pepper for OTP hashes (defaults to JWT_SECRET)
# OTP_PEPPER=

# API rate limits (per IP, per minute) — enforced for all /api/* via src/proxy.ts
API_RATE_LIMIT_PER_MINUTE=60
WRITE_RATE_LIMIT_PER_MINUTE=30
HEALTH_RATE_LIMIT_PER_MINUTE=120
BRIEF_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=20

# Registration + email OTP
REGISTRATION_ENABLED=true
EMAIL_OTP_ENABLED=true
# Global emergency switch for all outbound email
EMAIL_DELIVERY_ENABLED=true
# Bulk watchlist briefs are opt-in; OTP and user-created alerts are unaffected
WATCHLIST_BRIEF_EMAIL=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tell Research <noreply@example.com>
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
# Local / Playwright only — never enable in production
# TELL_OTP_DEV_ECHO=1
